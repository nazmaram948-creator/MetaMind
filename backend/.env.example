# Copy to .env (never commit .env). All keys are optional: with LLM_PROVIDER=none
# the app uses deterministic template text and rule-based skill extraction.

# LLM used ONLY for (a) CV text -> skill phrases (JSON) and (b) wording explanations
# from IDs/numbers we pass in. Options: none | anthropic | openai
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Paths (default: data/skillshift_<curated version>.db)
# SKILLSHIFT_DB=data/skillshift_v2.db

# Development fixtures are disabled by default. Enable only for local P1 work.
DEV_MODE=false
CORS_ORIGIN=http://localhost:5173
SIMULATION_RUNS=1000
SIMULATION_VARIATION=0.2

# Real engine instead of fixtures (see README: Engine mode)
ENGINE_MODE=false
# v1 = team curated files, v2 = ESCO-keyed files (data/curated/README.md)
CURATED_VERSION=v2
# minilm (sentence-transformers) or lexical (no model download)
SIMILARITY_BACKEND=minilm
